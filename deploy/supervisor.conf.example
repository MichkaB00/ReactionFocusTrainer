[program:focus]
directory=__PROJECT_DIR__
command="__PROJECT_DIR__/.venv-linux/bin/uwsgi" --ini "__PROJECT_DIR__/uwsgi.ini"
user=__RUN_USER__
environment=DJANGO_DEBUG="0",DJANGO_SECRET_KEY="__SECRET_KEY__",DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,[::1]"
autostart=true
autorestart=true
startsecs=5
stopsignal=TERM
stopasgroup=true
killasgroup=true
stdout_logfile=__PROJECT_DIR__/logs/uwsgi.log
stderr_logfile=__PROJECT_DIR__/logs/uwsgi-error.log
stdout_logfile_maxbytes=5MB
stderr_logfile_maxbytes=5MB
stdout_logfile_backups=2
stderr_logfile_backups=2
